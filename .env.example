# Node Environment
NODE_ENV=production
PORT=5000

# MongoDB Database URI (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hileap_prod?retryWrites=true&w=majority

# JWT & Cookie Session Secret Key
JWT_SECRET=production_super_secret_jwt_key_hileap_2026

# Company Payment & UPI Configuration
COMPANY_UPI_ID=hileapnetwork@upi
COMPANY_UPI_QR_URL=https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=upi://pay?pa=hileapnetwork@upi&pn=HiLeap%20Network

# External Subscription Management URL Templates (Placeholders: {BOX_ID}, {CUSTOMER_ID})
RECHARGE_URL=https://external-recharge-portal.example.com/recharge?boxId={BOX_ID}&customerId={CUSTOMER_ID}
PAUSE_RESUME_URL=https://external-recharge-portal.example.com/pause-resume?boxId={BOX_ID}&customerId={CUSTOMER_ID}
UNSUBSCRIBE_URL=https://external-recharge-portal.example.com/unsubscribe?boxId={BOX_ID}&customerId={CUSTOMER_ID}

# Frontend CORS Origin URL
FRONTEND_URL=https://hileap-network.vercel.app

# Optional Google Maps API Key
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere
